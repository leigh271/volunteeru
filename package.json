{
  "name": "volunteeru",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests \"server/*.js\" *.js *.json *.html README.md",
    "format:check": "prettier --check src tests \"server/*.js\" *.js *.json *.html README.md",
    "server": "node --experimental-sqlite server/index.js",
    "test:server": "node --experimental-sqlite --test server/*.test.js",
    "test:demo": "node --test scripts/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "prettier": "^3.9.10",
    "vite": "^6.1.0"
  }
}
