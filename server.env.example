# Optional authenticated API; values are read by server/index.js.
PORT=3001
DATABASE_PATH=server/data/volunteeru.sqlite
PUBLIC_ORIGIN=http://localhost:5173
# Use HTTPS and secure cookies for a deployment. Local loopback HTTP needs false.
SECURE_COOKIE=false
# Optional CUSTOM HTTPS JSON AI service implementing the contract in README.
# Keep the real key server-side. No AI provider is contacted when these are blank.
VOLUNTEERU_AI_URL=
VOLUNTEERU_AI_KEY=
